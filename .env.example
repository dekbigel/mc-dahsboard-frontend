# URL backend dashboard — HARUS reachable dari VPS Minecraft (VPS B).
# Contoh production: https://tomodaki.example.com/api/minecraft/events
BACKEND_URL=

# Secret autentikasi — WAJIB sama dengan MINECRAFT_EVENT_SECRET di .env backend.
# Kalau kosong, backend akan menolak event (503/401).
EVENT_SECRET=

# Mode file: path HOST volume Pterodactyl ke file console BDS.
# Contoh: /var/lib/pterodactyl/volumes/<UUID>/logs/tomodaki-console.log
LOG_FILE=

# Retry / backoff saat pengiriman gagal
RETRY_DELAY_MS=2000
MAX_RETRIES=5

# Interval polling file log (ms)
POLL_INTERVAL_MS=1000

# Batas antrian event di-memory (buang tertua saat penuh)
MAX_QUEUE=2000

# Companion membaca hanya 3 key: gamemode, difficulty, allow-cheats.
# Contoh: /var/lib/pterodactyl/volumes/<UUID>/server.properties
# Contoh: /var/lib/pterodactyl/volumes/<UUID>/permissions.json
SERVER_PROPERTIES_PATH=
PERMISSIONS_PATH=

# Interval polling & kirim konfigurasi server ke backend (ms)
SERVER_INFO_POLL_INTERVAL_MS=30000
